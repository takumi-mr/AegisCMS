{
  "name": "official-blocks",
  "version": "0.2.0",
  "entrypoint": "plugin.wasm",
  "display_name": "Content Blocks (Buttons, Cards, Media, Maps & Layouts)",
  "description": "Adds button, link card, video, audio, file download, map, image gallery, FAQ, steps, columns and image-with-text blocks to the editor. Also a small example of the render-blocks hook and of embedding with capabilities.embed.",
  "author": "AegisCMS Core Team",
  "license": "MIT OR Apache-2.0",
  "tags": [
    "blocks",
    "editor",
    "content",
    "video",
    "audio",
    "map",
    "gallery",
    "faq",
    "columns"
  ],
  "min_aegis_version": "0.1.0",
  "abi_version": 1,
  "capabilities": {
    "hooks": [
      "render-blocks"
    ],
    "embed": {
      "frame_domains": [
        "www.youtube-nocookie.com",
        "player.vimeo.com",
        "www.openstreetmap.org"
      ]
    }
  },
  "resource_limits": {
    "max_memory_mb": 16,
    "max_fuel_units": 20000000,
    "execution_timeout_ms": 250
  },
  "blocks": [
    {
      "name": "button",
      "label": {
        "en": "Button",
        "ja": "ボタン"
      },
      "description": {
        "en": "A link styled as a button",
        "ja": "ボタンの形のリンク"
      },
      "fields": [
        {
          "name": "label",
          "type": "string",
          "label": {
            "en": "Label",
            "ja": "ボタンの文字"
          },
          "required": true,
          "default": ""
        },
        {
          "name": "url",
          "type": "url",
          "label": {
            "en": "Link",
            "ja": "リンク先"
          },
          "required": true,
          "placeholder": "https://",
          "default": ""
        },
        {
          "name": "style",
          "type": "select",
          "label": {
            "en": "Style",
            "ja": "見た目"
          },
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": {
                "en": "Filled",
                "ja": "塗りつぶし"
              }
            },
            {
              "value": "secondary",
              "label": {
                "en": "Outline",
                "ja": "枠線"
              }
            }
          ]
        },
        {
          "name": "align",
          "type": "select",
          "label": {
            "en": "Alignment",
            "ja": "位置"
          },
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": {
                "en": "Left",
                "ja": "左"
              }
            },
            {
              "value": "center",
              "label": {
                "en": "Center",
                "ja": "中央"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "link-card",
      "label": {
        "en": "Link card",
        "ja": "リンクカード"
      },
      "description": {
        "en": "A link with a title, description and image",
        "ja": "タイトル・説明・画像つきのリンク"
      },
      "fields": [
        {
          "name": "url",
          "type": "url",
          "label": {
            "en": "Link",
            "ja": "リンク先"
          },
          "required": true,
          "placeholder": "https://",
          "default": ""
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "ja": "タイトル"
          },
          "required": true,
          "default": ""
        },
        {
          "name": "description",
          "type": "text",
          "label": {
            "en": "Description",
            "ja": "説明"
          },
          "default": ""
        },
        {
          "name": "image",
          "type": "image",
          "label": {
            "en": "Image",
            "ja": "画像"
          },
          "default": ""
        }
      ]
    },
    {
      "name": "video",
      "label": {
        "en": "Video",
        "ja": "動画"
      },
      "description": {
        "en": "A YouTube or Vimeo video",
        "ja": "YouTube・Vimeo の動画"
      },
      "fields": [
        {
          "name": "url",
          "type": "url",
          "label": {
            "en": "Video URL",
            "ja": "動画の URL"
          },
          "required": true,
          "placeholder": "https://www.youtube.com/watch?v=...",
          "default": "",
          "help": {
            "en": "A YouTube (youtube.com, youtu.be, Shorts) or Vimeo URL. YouTube's start time (t=90 or t=1m30s) is kept.",
            "ja": "YouTube（youtube.com・youtu.be・ショート）か Vimeo の URL。YouTube の再生開始位置（t=90、t=1m30s）も使えます。"
          }
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Title (for screen readers)",
            "ja": "タイトル（読み上げ用）"
          },
          "default": ""
        },
        {
          "name": "aspect",
          "type": "select",
          "label": {
            "en": "Shape",
            "ja": "形"
          },
          "default": "16x9",
          "options": [
            {
              "value": "16x9",
              "label": {
                "en": "Wide (16:9)",
                "ja": "横長（16:9）"
              }
            },
            {
              "value": "4x3",
              "label": {
                "en": "Standard (4:3)",
                "ja": "標準（4:3）"
              }
            },
            {
              "value": "9x16",
              "label": {
                "en": "Vertical (9:16, Shorts)",
                "ja": "縦長（9:16・ショート）"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "audio",
      "label": {
        "en": "Audio",
        "ja": "音声"
      },
      "description": {
        "en": "An audio player for a podcast or narration",
        "ja": "ポッドキャストやナレーション用の音声プレーヤー"
      },
      "fields": [
        {
          "name": "url",
          "type": "url",
          "label": {
            "en": "Audio URL",
            "ja": "音声の URL"
          },
          "required": true,
          "default": "",
          "placeholder": "https://",
          "help": {
            "en": "A link to an MP3, M4A, OGG or WAV file.",
            "ja": "MP3・M4A・OGG・WAV などのファイルの URL。"
          }
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "ja": "タイトル"
          },
          "default": ""
        }
      ]
    },
    {
      "name": "file",
      "label": {
        "en": "File download",
        "ja": "ファイルのダウンロード"
      },
      "description": {
        "en": "A download link with a title, description and size",
        "ja": "タイトル・説明・サイズつきのダウンロードリンク"
      },
      "fields": [
        {
          "name": "url",
          "type": "url",
          "label": {
            "en": "File URL",
            "ja": "ファイルの URL"
          },
          "required": true,
          "default": "",
          "placeholder": "https://"
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "ja": "タイトル"
          },
          "required": true,
          "default": ""
        },
        {
          "name": "description",
          "type": "string",
          "label": {
            "en": "Description",
            "ja": "説明"
          },
          "default": ""
        },
        {
          "name": "size",
          "type": "string",
          "label": {
            "en": "Size",
            "ja": "サイズ"
          },
          "default": "",
          "placeholder": "2.4 MB",
          "help": {
            "en": "Shown as written (for example PDF, 2.4 MB).",
            "ja": "書いたとおりに表示します（例: PDF・2.4 MB）。"
          }
        }
      ]
    },
    {
      "name": "map",
      "label": {
        "en": "Map",
        "ja": "地図"
      },
      "description": {
        "en": "An OpenStreetMap map with a marker",
        "ja": "マーカーつきの OpenStreetMap の地図"
      },
      "fields": [
        {
          "name": "latitude",
          "type": "number",
          "label": {
            "en": "Latitude",
            "ja": "緯度"
          },
          "required": true,
          "placeholder": "35.6812",
          "help": {
            "en": "-85 to 85. Right-click a place on openstreetmap.org to copy its coordinates.",
            "ja": "-85〜85。openstreetmap.org で場所を右クリックすると座標をコピーできます。"
          }
        },
        {
          "name": "longitude",
          "type": "number",
          "label": {
            "en": "Longitude",
            "ja": "経度"
          },
          "required": true,
          "placeholder": "139.7671",
          "help": {
            "en": "-180 to 180.",
            "ja": "-180〜180。"
          }
        },
        {
          "name": "zoom",
          "type": "number",
          "label": {
            "en": "Zoom",
            "ja": "拡大率"
          },
          "default": 15,
          "help": {
            "en": "1 (the world) to 19 (a building). Empty uses 15.",
            "ja": "1（世界）〜19（建物）。空欄なら 15。"
          }
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Place name",
            "ja": "場所の名前"
          },
          "default": "",
          "help": {
            "en": "Shown under the map and read aloud for the frame.",
            "ja": "地図の下に出し、フレームの読み上げにも使います。"
          }
        }
      ]
    },
    {
      "name": "gallery",
      "label": {
        "en": "Image gallery",
        "ja": "画像ギャラリー"
      },
      "description": {
        "en": "Several images in a grid",
        "ja": "複数の画像をグリッドで並べる"
      },
      "fields": [
        {
          "name": "images",
          "type": "list",
          "label": {
            "en": "Images",
            "ja": "画像"
          },
          "required": true,
          "max_items": 24,
          "help": {
            "en": "Up to 24 images. The caption is also the alt text.",
            "ja": "24 枚まで。説明は alt にも使います。"
          },
          "fields": [
            {
              "name": "image",
              "type": "image",
              "label": {
                "en": "Image",
                "ja": "画像"
              },
              "required": true,
              "default": ""
            },
            {
              "name": "caption",
              "type": "string",
              "label": {
                "en": "Caption",
                "ja": "説明"
              },
              "default": ""
            }
          ]
        },
        {
          "name": "columns",
          "type": "select",
          "label": {
            "en": "Columns",
            "ja": "列の数"
          },
          "default": "3",
          "options": [
            {
              "value": "2",
              "label": {
                "en": "2",
                "ja": "2"
              }
            },
            {
              "value": "3",
              "label": {
                "en": "3",
                "ja": "3"
              }
            },
            {
              "value": "4",
              "label": {
                "en": "4",
                "ja": "4"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "faq",
      "label": {
        "en": "FAQ",
        "ja": "よくある質問"
      },
      "description": {
        "en": "Questions that open to show the answer",
        "ja": "質問をクリックして答えを開く"
      },
      "fields": [
        {
          "name": "items",
          "type": "list",
          "label": {
            "en": "Questions and answers",
            "ja": "質問と答え"
          },
          "required": true,
          "max_items": 50,
          "fields": [
            {
              "name": "question",
              "type": "string",
              "label": {
                "en": "Question",
                "ja": "質問"
              },
              "required": true,
              "default": ""
            },
            {
              "name": "answer",
              "type": "text",
              "label": {
                "en": "Answer",
                "ja": "答え"
              },
              "default": "",
              "help": {
                "en": "Plain text. Each line becomes a paragraph.",
                "ja": "プレーンテキスト。1 行が 1 段落になります。"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "steps",
      "label": {
        "en": "Steps",
        "ja": "手順"
      },
      "description": {
        "en": "A numbered list of steps with a title and a description",
        "ja": "番号つきの手順（見出しと説明）"
      },
      "fields": [
        {
          "name": "items",
          "type": "list",
          "label": {
            "en": "Steps",
            "ja": "手順"
          },
          "required": true,
          "max_items": 30,
          "fields": [
            {
              "name": "title",
              "type": "string",
              "label": {
                "en": "Title",
                "ja": "見出し"
              },
              "required": true,
              "default": ""
            },
            {
              "name": "description",
              "type": "text",
              "label": {
                "en": "Description",
                "ja": "説明"
              },
              "default": ""
            }
          ]
        }
      ]
    },
    {
      "name": "media-text",
      "label": {
        "en": "Image with text",
        "ja": "画像と文章"
      },
      "description": {
        "en": "An image beside a title and text; stacks on narrow screens",
        "ja": "画像と文章を横に並べる（狭い画面では縦に積む）"
      },
      "fields": [
        {
          "name": "image",
          "type": "image",
          "label": {
            "en": "Image",
            "ja": "画像"
          },
          "required": true,
          "default": ""
        },
        {
          "name": "alt",
          "type": "string",
          "label": {
            "en": "Image description (alt)",
            "ja": "画像の説明（alt）"
          },
          "default": ""
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "ja": "見出し"
          },
          "default": ""
        },
        {
          "name": "text",
          "type": "text",
          "label": {
            "en": "Text",
            "ja": "文章"
          },
          "default": "",
          "help": {
            "en": "Plain text. A blank line starts a new paragraph.",
            "ja": "プレーンテキスト。空行で段落を分けます。"
          }
        },
        {
          "name": "side",
          "type": "select",
          "label": {
            "en": "Image position",
            "ja": "画像の位置"
          },
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": {
                "en": "Left",
                "ja": "左"
              }
            },
            {
              "value": "right",
              "label": {
                "en": "Right",
                "ja": "右"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "columns",
      "label": {
        "en": "Columns",
        "ja": "カラム"
      },
      "description": {
        "en": "Two to four columns with an image, a title and text; stack on narrow screens",
        "ja": "画像・見出し・文章の列を 2〜4 つ並べる（狭い画面では縦に積む）"
      },
      "fields": [
        {
          "name": "items",
          "type": "list",
          "label": {
            "en": "Columns",
            "ja": "カラム"
          },
          "required": true,
          "max_items": 4,
          "fields": [
            {
              "name": "image",
              "type": "image",
              "label": {
                "en": "Image",
                "ja": "画像"
              },
              "default": ""
            },
            {
              "name": "title",
              "type": "string",
              "label": {
                "en": "Title",
                "ja": "見出し"
              },
              "default": ""
            },
            {
              "name": "text",
              "type": "text",
              "label": {
                "en": "Text",
                "ja": "文章"
              },
              "default": "",
              "help": {
                "en": "Plain text. Each line becomes a paragraph.",
                "ja": "プレーンテキスト。1 行が 1 段落になります。"
              }
            }
          ]
        }
      ]
    }
  ]
}
