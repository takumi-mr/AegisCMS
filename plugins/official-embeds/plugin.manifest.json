{
  "name": "official-embeds",
  "version": "0.1.0",
  "entrypoint": "plugin.wasm",
  "display_name": "Embeds (Video, Maps, CodePen, Google Calendar & Forms)",
  "description": "Adds blocks that embed external services in the body: YouTube and Vimeo videos, OpenStreetMap and Google Maps maps, CodePen pens, Google Calendar and Google Forms. A generic embed block frames pages on hosts the site's administrator allows. Only the services' own players are framed, and their hosts are added to the CSP frame-src while the plugin is enabled.",
  "author": "AegisCMS Core Team",
  "license": "MIT OR Apache-2.0",
  "tags": [
    "blocks",
    "embed",
    "video",
    "map",
    "codepen",
    "google"
  ],
  "min_aegis_version": "0.1.0",
  "abi_version": 1,
  "capabilities": {
    "hooks": [
      "render-blocks"
    ],
    "embed": {
      "frame_domains": [
        "www.youtube-nocookie.com",
        "player.vimeo.com",
        "www.openstreetmap.org",
        "codepen.io",
        "www.google.com",
        "calendar.google.com",
        "docs.google.com"
      ],
      "site_domains": true
    }
  },
  "resource_limits": {
    "max_memory_mb": 16,
    "max_fuel_units": 20000000,
    "execution_timeout_ms": 250
  },
  "blocks": [
    {
      "name": "video",
      "label": {
        "en": "Video",
        "ja": "動画"
      },
      "description": {
        "en": "A YouTube or Vimeo video",
        "ja": "YouTube・Vimeo の動画"
      },
      "fields": [
        {
          "name": "url",
          "type": "url",
          "label": {
            "en": "Video URL",
            "ja": "動画の URL"
          },
          "required": true,
          "placeholder": "https://www.youtube.com/watch?v=...",
          "default": "",
          "help": {
            "en": "A YouTube (youtube.com, youtu.be, Shorts) or Vimeo URL. YouTube's start time (t=90 or t=1m30s) is kept.",
            "ja": "YouTube（youtube.com・youtu.be・ショート）か Vimeo の URL。YouTube の再生開始位置（t=90、t=1m30s）も使えます。"
          }
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Title (for screen readers)",
            "ja": "タイトル（読み上げ用）"
          },
          "default": ""
        },
        {
          "name": "aspect",
          "type": "select",
          "label": {
            "en": "Shape",
            "ja": "形"
          },
          "default": "16x9",
          "options": [
            {
              "value": "16x9",
              "label": {
                "en": "Wide (16:9)",
                "ja": "横長（16:9）"
              }
            },
            {
              "value": "4x3",
              "label": {
                "en": "Standard (4:3)",
                "ja": "標準（4:3）"
              }
            },
            {
              "value": "9x16",
              "label": {
                "en": "Vertical (9:16, Shorts)",
                "ja": "縦長（9:16・ショート）"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "openstreetmap",
      "label": {
        "en": "Map (OpenStreetMap)",
        "ja": "地図（OpenStreetMap）"
      },
      "description": {
        "en": "An OpenStreetMap map with a marker",
        "ja": "マーカーつきの OpenStreetMap の地図"
      },
      "fields": [
        {
          "name": "latitude",
          "type": "number",
          "label": {
            "en": "Latitude",
            "ja": "緯度"
          },
          "required": true,
          "placeholder": "35.6812",
          "help": {
            "en": "-85 to 85. Right-click a place on openstreetmap.org to copy its coordinates.",
            "ja": "-85〜85。openstreetmap.org で場所を右クリックすると座標をコピーできます。"
          }
        },
        {
          "name": "longitude",
          "type": "number",
          "label": {
            "en": "Longitude",
            "ja": "経度"
          },
          "required": true,
          "placeholder": "139.7671",
          "help": {
            "en": "-180 to 180.",
            "ja": "-180〜180。"
          }
        },
        {
          "name": "zoom",
          "type": "number",
          "label": {
            "en": "Zoom",
            "ja": "拡大率"
          },
          "default": 15,
          "help": {
            "en": "1 (the world) to 19 (a building). Empty uses 15.",
            "ja": "1（世界）〜19（建物）。空欄なら 15。"
          }
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Place name",
            "ja": "場所の名前"
          },
          "default": "",
          "help": {
            "en": "Shown under the map and read aloud for the frame.",
            "ja": "地図の下に出し、フレームの読み上げにも使います。"
          }
        }
      ]
    },
    {
      "name": "codepen",
      "label": {
        "en": "CodePen",
        "ja": "CodePen"
      },
      "description": {
        "en": "A CodePen pen with its result and code",
        "ja": "CodePen の Pen（実行結果とコード）"
      },
      "fields": [
        {
          "name": "url",
          "type": "text",
          "label": {
            "en": "Pen URL",
            "ja": "Pen の URL"
          },
          "required": true,
          "placeholder": "https://codepen.io/<user>/pen/<id>",
          "default": "",
          "help": {
            "en": "The pen's URL (codepen.io/<user>/pen/<id>). CodePen's embed code (the iframe form) also works.",
            "ja": "Pen の URL（codepen.io/<ユーザー>/pen/<ID>）。CodePen の埋め込みのコード（iframe の形）を貼っても使えます。"
          }
        },
        {
          "name": "tab",
          "type": "select",
          "label": {
            "en": "First tab",
            "ja": "最初に開くタブ"
          },
          "default": "result",
          "options": [
            {
              "value": "result",
              "label": {
                "en": "Result",
                "ja": "実行結果"
              }
            },
            {
              "value": "html",
              "label": {
                "en": "HTML + result",
                "ja": "HTML と実行結果"
              }
            },
            {
              "value": "css",
              "label": {
                "en": "CSS + result",
                "ja": "CSS と実行結果"
              }
            },
            {
              "value": "js",
              "label": {
                "en": "JS + result",
                "ja": "JS と実行結果"
              }
            }
          ]
        },
        {
          "name": "height",
          "type": "number",
          "label": {
            "en": "Height (px)",
            "ja": "高さ（px）"
          },
          "default": 400,
          "help": {
            "en": "200 to 1200. Empty uses 400.",
            "ja": "200〜1200。空欄なら 400。"
          }
        },
        {
          "name": "click_to_load",
          "type": "boolean",
          "label": {
            "en": "Run on click",
            "ja": "クリックで実行"
          },
          "default": false,
          "help": {
            "en": "Shows a preview and runs the pen only when the visitor clicks it. Good for heavy pens.",
            "ja": "プレビューを出し、訪問者がクリックしたときだけ Pen を動かします。重い Pen 向けです。"
          }
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Title (for screen readers)",
            "ja": "タイトル（読み上げ用）"
          },
          "default": ""
        }
      ]
    },
    {
      "name": "google-map",
      "label": {
        "en": "Google Maps",
        "ja": "Google マップ"
      },
      "description": {
        "en": "A Google Maps map (no API key needed)",
        "ja": "Google マップの地図（API キー不要）"
      },
      "fields": [
        {
          "name": "embed",
          "type": "text",
          "label": {
            "en": "Embed code",
            "ja": "埋め込みのコード"
          },
          "required": true,
          "placeholder": "<iframe src=\"https://www.google.com/maps/embed?pb=...\" ...></iframe>",
          "default": "",
          "help": {
            "en": "In Google Maps, choose Share › Embed a map › Copy HTML and paste it here (or only its https://www.google.com/maps/embed?pb=... URL). Only the map's pb value is used.",
            "ja": "Google マップで「共有」›「地図を埋め込む」›「HTML をコピー」を選び、ここに貼ります（https://www.google.com/maps/embed?pb=... の URL だけでも可）。使うのは地図の pb の値だけです。"
          }
        },
        {
          "name": "aspect",
          "type": "select",
          "label": {
            "en": "Shape",
            "ja": "形"
          },
          "default": "16x10",
          "options": [
            {
              "value": "16x10",
              "label": {
                "en": "Wide (16:10)",
                "ja": "横長（16:10）"
              }
            },
            {
              "value": "4x3",
              "label": {
                "en": "Standard (4:3)",
                "ja": "標準（4:3）"
              }
            },
            {
              "value": "1x1",
              "label": {
                "en": "Square (1:1)",
                "ja": "正方形（1:1）"
              }
            }
          ]
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Place name",
            "ja": "場所の名前"
          },
          "default": "",
          "help": {
            "en": "Shown under the map and read aloud for the frame.",
            "ja": "地図の下に出し、フレームの読み上げにも使います。"
          }
        }
      ]
    },
    {
      "name": "google-calendar",
      "label": {
        "en": "Google Calendar",
        "ja": "Google カレンダー"
      },
      "description": {
        "en": "A public Google Calendar",
        "ja": "公開している Google カレンダー"
      },
      "fields": [
        {
          "name": "calendar",
          "type": "text",
          "label": {
            "en": "Calendar",
            "ja": "カレンダー"
          },
          "required": true,
          "placeholder": "xxxx@group.calendar.google.com",
          "default": "",
          "help": {
            "en": "The calendar ID, or the embed code / URL from the calendar's settings (Integrate calendar). Several calendars in the embed code are kept (up to 10). The calendar must be public.",
            "ja": "カレンダー ID か、カレンダーの設定（「カレンダーの統合」）にある埋め込みのコード・URL。埋め込みのコードに複数のカレンダーがあれば、そのまま並べます（10 件まで）。カレンダーは一般公開にしておく必要があります。"
          }
        },
        {
          "name": "mode",
          "type": "select",
          "label": {
            "en": "View",
            "ja": "表示"
          },
          "default": "month",
          "options": [
            {
              "value": "month",
              "label": {
                "en": "Month",
                "ja": "月"
              }
            },
            {
              "value": "week",
              "label": {
                "en": "Week",
                "ja": "週"
              }
            },
            {
              "value": "agenda",
              "label": {
                "en": "Agenda",
                "ja": "予定リスト"
              }
            }
          ]
        },
        {
          "name": "timezone",
          "type": "string",
          "label": {
            "en": "Time zone",
            "ja": "タイムゾーン"
          },
          "default": "",
          "placeholder": "Asia/Tokyo",
          "help": {
            "en": "Empty uses the one in the embed code, or the calendar's own.",
            "ja": "空欄なら埋め込みのコードにあるもの、無ければカレンダーのもの。"
          }
        },
        {
          "name": "height",
          "type": "number",
          "label": {
            "en": "Height (px)",
            "ja": "高さ（px）"
          },
          "default": 600,
          "help": {
            "en": "300 to 1200. Empty uses 600.",
            "ja": "300〜1200。空欄なら 600。"
          }
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Title (for screen readers)",
            "ja": "タイトル（読み上げ用）"
          },
          "default": ""
        }
      ]
    },
    {
      "name": "google-form",
      "label": {
        "en": "Google Forms",
        "ja": "Google フォーム"
      },
      "description": {
        "en": "A Google Forms form",
        "ja": "Google フォームのフォーム"
      },
      "fields": [
        {
          "name": "url",
          "type": "text",
          "label": {
            "en": "Form URL",
            "ja": "フォームの URL"
          },
          "required": true,
          "placeholder": "https://docs.google.com/forms/d/e/.../viewform",
          "default": "",
          "help": {
            "en": "The form's link (docs.google.com/forms/...) or its embed code from Send › <>. Short links (forms.gle) cannot be used; open them and copy the full URL.",
            "ja": "フォームのリンク（docs.google.com/forms/...）か、「送信」›「<>」の埋め込みのコード。短縮 URL（forms.gle）は使えないので、開いて長い URL をコピーしてください。"
          }
        },
        {
          "name": "height",
          "type": "number",
          "label": {
            "en": "Height (px)",
            "ja": "高さ（px）"
          },
          "default": 800,
          "help": {
            "en": "300 to 3000. Empty uses 800.",
            "ja": "300〜3000。空欄なら 800。"
          }
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Title (for screen readers)",
            "ja": "タイトル（読み上げ用）"
          },
          "default": ""
        }
      ]
    },
    {
      "name": "iframe",
      "label": {
        "en": "Embed (allowed sites)",
        "ja": "埋め込み（許可したサイト）"
      },
      "description": {
        "en": "A page on a host the site's administrator allows (Settings › Headers)",
        "ja": "サイトの管理者が許可したホストのページ（Settings › Headers）"
      },
      "fields": [
        {
          "name": "url",
          "type": "url",
          "label": {
            "en": "Page URL",
            "ja": "ページの URL"
          },
          "required": true,
          "placeholder": "https://",
          "default": "",
          "help": {
            "en": "An https:// URL on a host allowed in Settings › Headers (or [embed].frame_domains in the config file). Other hosts are not shown.",
            "ja": "Settings › Headers（または設定ファイルの [embed].frame_domains）で許可したホストの https:// の URL。ほかのホストは表示されません。"
          }
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Title (for screen readers)",
            "ja": "タイトル（読み上げ用）"
          },
          "required": true,
          "default": "",
          "help": {
            "en": "Describes the frame for screen readers. Empty uses the host name.",
            "ja": "フレームの内容を読み上げで伝えます。空欄ならホスト名。"
          }
        },
        {
          "name": "height",
          "type": "number",
          "label": {
            "en": "Height (px)",
            "ja": "高さ（px）"
          },
          "default": 500,
          "help": {
            "en": "100 to 3000. Empty uses 500.",
            "ja": "100〜3000。空欄なら 500。"
          }
        },
        {
          "name": "allow_fullscreen",
          "type": "boolean",
          "label": {
            "en": "Allow full screen",
            "ja": "全画面表示を許可"
          },
          "default": false
        }
      ]
    }
  ]
}
