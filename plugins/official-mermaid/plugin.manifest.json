{
  "name": "official-mermaid",
  "version": "0.2.0",
  "entrypoint": "plugin.wasm",
  "display_name": "Mermaid Diagrams",
  "description": "Draws Mermaid diagrams from ```mermaid code blocks. Mermaid is loaded only on pages that have a diagram. Configure it in Settings > Plugins.",
  "author": "AegisCMS Core Team",
  "license": "MIT OR Apache-2.0",
  "tags": [
    "diagram",
    "mermaid",
    "content"
  ],
  "min_aegis_version": "0.1.0",
  "abi_version": 2,
  "capabilities": {
    "render_page": {
      "input": [
        "content_html"
      ]
    },
    "hooks": [
      "on-render-page"
    ],
    "csp": {
      "script_domains": [
        "cdn.jsdelivr.net"
      ]
    },
    "inline_scripts": true
  },
  "resource_limits": {
    "max_memory_mb": 16,
    "max_fuel_units": 20000000,
    "execution_timeout_ms": 250
  },
  "settings": [
    {
      "key": "theme",
      "type": "select",
      "label": {
        "en": "Diagram theme",
        "ja": "図のテーマ"
      },
      "description": {
        "en": "Auto follows the page: a dark page gets the dark theme, a light page the default one.",
        "ja": "自動は、ページに合わせる（暗いページは dark、明るいページは default）。"
      },
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Auto",
            "ja": "自動"
          }
        },
        {
          "value": "default",
          "label": {
            "en": "Default",
            "ja": "default"
          }
        },
        {
          "value": "dark",
          "label": {
            "en": "Dark",
            "ja": "dark"
          }
        },
        {
          "value": "neutral",
          "label": {
            "en": "Neutral",
            "ja": "neutral"
          }
        },
        {
          "value": "forest",
          "label": {
            "en": "Forest",
            "ja": "forest"
          }
        }
      ]
    },
    {
      "key": "security_level",
      "type": "select",
      "label": {
        "en": "Security level",
        "ja": "セキュリティレベル"
      },
      "description": {
        "en": "strict does not allow HTML or click handlers inside a diagram. Loosen it only for diagrams written by people you trust.",
        "ja": "strict は、図の中の HTML・クリック処理を許さない。信頼できる人が書く図のときだけ緩める。"
      },
      "default": "strict",
      "options": [
        {
          "value": "strict",
          "label": {
            "en": "strict (recommended)",
            "ja": "strict（おすすめ）"
          }
        },
        {
          "value": "antiscript",
          "label": {
            "en": "antiscript",
            "ja": "antiscript"
          }
        },
        {
          "value": "loose",
          "label": {
            "en": "loose",
            "ja": "loose"
          }
        },
        {
          "value": "sandbox",
          "label": {
            "en": "sandbox",
            "ja": "sandbox"
          }
        }
      ]
    },
    {
      "key": "script_url",
      "type": "url",
      "label": {
        "en": "Mermaid script URL",
        "ja": "Mermaid のスクリプトの URL"
      },
      "description": {
        "en": "Use a path on your own site (starting with /) to self-host Mermaid, or an https://cdn.jsdelivr.net URL. The host drops a script from any other host.",
        "ja": "自分のサイトに置くときは、/ で始まるパスにする。ほかは https://cdn.jsdelivr.net の URL だけ（別のホストのスクリプトは、ホストが捨てる）。"
      },
      "placeholder": "https://cdn.jsdelivr.net/npm/mermaid@10.9.3/dist/mermaid.min.js"
    }
  ]
}
