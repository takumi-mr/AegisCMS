{
  "name": "official-charts",
  "version": "0.2.0",
  "entrypoint": "plugin.wasm",
  "display_name": "Charts (Bar, Line & Donut)",
  "description": "Adds bar, stacked bar, horizontal bar, line and donut chart blocks to the editor. Renders accessible SVG charts on the server with multi-series support and no JavaScript.",
  "author": "AegisCMS Core Team",
  "license": "MIT OR Apache-2.0",
  "tags": [
    "blocks",
    "editor",
    "content",
    "charts",
    "svg"
  ],
  "min_aegis_version": "0.1.0",
  "abi_version": 2,
  "capabilities": {
    "hooks": [
      "render-blocks"
    ]
  },
  "resource_limits": {
    "max_memory_mb": 16,
    "max_fuel_units": 20000000,
    "execution_timeout_ms": 250
  },
  "blocks": [
    {
      "name": "chart",
      "label": {
        "en": "Chart",
        "ja": "グラフ"
      },
      "description": {
        "en": "Bar, stacked bar, horizontal bar, line or donut chart with multi-series support",
        "ja": "縦棒・積み上げ棒・横棒・折れ線・ドーナツグラフ（複数系列対応）"
      },
      "fields": [
        {
          "name": "type",
          "type": "select",
          "label": {
            "en": "Chart type",
            "ja": "種類"
          },
          "default": "bar",
          "options": [
            {
              "value": "bar",
              "label": {
                "en": "Bar",
                "ja": "縦棒グラフ"
              }
            },
            {
              "value": "stacked-bar",
              "label": {
                "en": "Stacked bar",
                "ja": "積み上げ棒グラフ"
              }
            },
            {
              "value": "horizontal-bar",
              "label": {
                "en": "Horizontal bar",
                "ja": "横棒グラフ"
              }
            },
            {
              "value": "line",
              "label": {
                "en": "Line",
                "ja": "折れ線グラフ"
              }
            },
            {
              "value": "donut",
              "label": {
                "en": "Donut",
                "ja": "ドーナツグラフ"
              }
            }
          ]
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "ja": "タイトル"
          },
          "default": ""
        },
        {
          "name": "unit",
          "type": "string",
          "label": {
            "en": "Unit",
            "ja": "単位"
          },
          "placeholder": "%, ms, req/s",
          "default": ""
        },
        {
          "name": "series",
          "type": "string",
          "label": {
            "en": "Series names",
            "ja": "系列名"
          },
          "placeholder": {
            "en": "2025, 2026",
            "ja": "2025年, 2026年"
          },
          "help": {
            "en": "Leave empty for a single series. For multiple series, list their names separated by commas (up to 6).",
            "ja": "1 系列のときは空欄。複数系列を並べるときは、名前をカンマで区切って書きます（6 系列まで）。"
          },
          "default": ""
        },
        {
          "name": "max",
          "type": "number",
          "label": {
            "en": "Axis maximum",
            "ja": "最大値"
          },
          "help": {
            "en": "Leave empty to calculate automatically from the data.",
            "ja": "空欄ならデータの最大値から自動で決めます。"
          }
        },
        {
          "name": "items",
          "type": "list",
          "label": {
            "en": "Data rows",
            "ja": "データ"
          },
          "required": true,
          "max_items": 50,
          "fields": [
            {
              "name": "label",
              "type": "string",
              "label": {
                "en": "Label",
                "ja": "項目名"
              },
              "required": true,
              "default": ""
            },
            {
              "name": "values",
              "type": "string",
              "label": {
                "en": "Value(s)",
                "ja": "値"
              },
              "required": true,
              "placeholder": "120, 150",
              "help": {
                "en": "A number, or comma-separated numbers for multiple series.",
                "ja": "数値。複数系列のときはカンマ区切りで並べます（例: 120, 150）。"
              },
              "default": ""
            }
          ]
        }
      ]
    }
  ]
}

