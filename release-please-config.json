        {
          "type": "toml",
          "path": "sdk/templates/rust/Cargo.toml",
          "jsonpath": "$.dependencies.aegis-plugin-sdk.version"
        },
        {
          "type": "json",
          "path": "admin/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "admin/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "admin/package-lock.json",
          "jsonpath": "$.packages[''].version"
        },
        {
          "type": "json",
          "path": "theme-builder/package.json",
