{
  "components": {
    "schemas": {
      "ArticleContent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseContentItem"
          },
          {
            "properties": {
              "category_id": {
                "description": "Foreign key relation to category.id",
                "nullable": true,
                "type": "string"
              },
              "custom_meta": {
                "additionalProperties": true,
                "type": "object"
              },
              "excerpt": {
                "maxLength": 500,
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          }
        ],
        "description": "Content model for 技術記事",
        "type": "object"
      },
      "BaseContentItem": {
        "properties": {
          "author_id": {
            "nullable": true,
            "type": "string"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/BlockNode"
            },
            "type": "array"
          },
          "content_type": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "published_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "rendered_html": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ContentStatus"
          },
          "title": {
            "type": "string"
          },
          "unpublish_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "content_type",
          "title",
          "slug",
          "status",
          "blocks",
          "rendered_html",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "BlockNode": {
        "properties": {
          "attributes": {
            "additionalProperties": true,
            "type": "object"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/BlockNode"
            },
            "type": "array"
          },
          "name": {
            "example": "core/heading",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CategoryContent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseContentItem"
          },
          {
            "properties": {
              "color": {
                "nullable": true,
                "type": "string"
              },
              "description": {
                "nullable": true,
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          }
        ],
        "description": "Content model for カテゴリ",
        "type": "object"
      },
      "ContentStatus": {
        "enum": [
          "draft",
          "scheduled",
          "published",
          "archived"
        ],
        "type": "string"
      },
      "CreateContentPayload": {
        "properties": {
          "author_id": {
            "nullable": true,
            "type": "string"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/BlockNode"
            },
            "type": "array"
          },
          "published_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ContentStatus"
          },
          "title": {
            "type": "string"
          },
          "unpublish_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "title",
          "slug"
        ],
        "type": "object"
      },
      "FieldDefinition": {
        "properties": {
          "index": {
            "type": "boolean"
          },
          "indexed_paths": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "max_length": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "nullable": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "enum": [
              "string",
              "text",
              "integer",
              "boolean",
              "timestamp",
              "relation",
              "jsonb"
            ],
            "type": "string"
          },
          "unique": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "type": "object"
      },
      "PageContent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseContentItem"
          },
          {
            "properties": {
              "custom_meta": {
                "additionalProperties": true,
                "type": "object"
              },
              "layout": {
                "nullable": true,
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          }
        ],
        "description": "Content model for 固定ページ",
        "type": "object"
      },
      "ProductContent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseContentItem"
          },
          {
            "properties": {
              "buy_url": {
                "nullable": true,
                "type": "string"
              },
              "category_id": {
                "description": "Foreign key relation to category.id",
                "nullable": true,
                "type": "string"
              },
              "compare_at_price": {
                "nullable": true,
                "type": "integer"
              },
              "excerpt": {
                "maxLength": 500,
                "nullable": true,
                "type": "string"
              },
              "image_url": {
                "nullable": true,
                "type": "string"
              },
              "price": {
                "type": "integer"
              },
              "sku": {
                "nullable": true,
                "type": "string"
              },
              "stock": {
                "nullable": true,
                "type": "integer"
              }
            },
            "required": [
              "price"
            ],
            "type": "object"
          }
        ],
        "description": "Content model for 商品",
        "type": "object"
      },
      "SchemaDefinition": {
        "properties": {
          "content_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldDefinition"
            },
            "type": "array"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "content_type",
          "label",
          "fields"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Zero-Trust Extensible Content Management System REST API specification.",
    "title": "AegisCMS REST API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/contents/{content_type}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "content_type",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size (at most 500)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ContentStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "contents": {
                      "items": {
                        "$ref": "#/components/schemas/BaseContentItem"
                      },
                      "type": "array"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "contents",
                    "total",
                    "limit",
                    "offset"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "One page of content records (newest first) and the number of matching records"
          }
        },
        "summary": "List contents by content type",
        "tags": [
          "Contents"
        ]
      },
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "content_type",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContentPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseContentItem"
                }
              }
            },
            "description": "Content successfully created"
          },
          "400": {
            "description": "Invalid payload, validation failed or an on-before-save plugin hook failed"
          },
          "404": {
            "description": "Schema content_type not registered"
          },
          "422": {
            "description": "Rejected by an on-before-save plugin hook, or a JSON body that does not match the request type"
          }
        },
        "summary": "Create new content",
        "tags": [
          "Contents"
        ]
      }
    },
    "/api/v1/contents/{content_type}/{slug}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "content_type",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseContentItem"
                }
              }
            },
            "description": "Content record details"
          },
          "404": {
            "description": "Content not found"
          }
        },
        "summary": "Get content by slug",
        "tags": [
          "Contents"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Check if AegisCMS core service and database connection are healthy.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "database": {
                      "example": "connected",
                      "type": "string"
                    },
                    "status": {
                      "example": "ok",
                      "type": "string"
                    },
                    "version": {
                      "example": "0.1.0",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "database"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Service is healthy"
          }
        },
        "summary": "Health check",
        "tags": [
          "System"
        ]
      }
    },
    "/api/v1/schemas": {
      "get": {
        "description": "Retrieve list of all active declarative schemas loaded by AegisCMS.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SchemaDefinition"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of schemas"
          }
        },
        "summary": "List all content schemas",
        "tags": [
          "Schemas"
        ]
      }
    },
    "/api/v1/schemas/{content_type}": {
      "get": {
        "parameters": [
          {
            "description": "Content type identifier (e.g. article)",
            "in": "path",
            "name": "content_type",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaDefinition"
                }
              }
            },
            "description": "Schema definition details"
          },
          "404": {
            "description": "Schema not found"
          }
        },
        "summary": "Get schema definition",
        "tags": [
          "Schemas"
        ]
      }
    }
  }
}