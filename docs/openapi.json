{
  "components": {
    "schemas": {
      "ArticleContent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseContentItem"
          },
          {
            "properties": {
              "category_id": {
                "description": "Foreign key relation to category.id",
                "nullable": true,
                "type": "string"
              },
              "custom_meta": {
                "additionalProperties": true,
                "type": "object"
              },
              "excerpt": {
                "maxLength": 500,
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          }
        ],
        "description": "Content model for 技術記事",
        "type": "object"
      },
      "BaseContentItem": {
        "properties": {
          "author_id": {
            "nullable": true,
            "type": "string"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/BlockNode"
            },
            "type": "array"
          },
          "content_type": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "published_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "rendered_html": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ContentStatus"
          },
          "title": {
            "type": "string"
          },
          "unpublish_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "content_type",
          "title",
          "slug",
          "status",
          "blocks",
          "rendered_html",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "BlockNode": {
        "properties": {
          "attributes": {
            "additionalProperties": true,
            "type": "object"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/BlockNode"
            },
            "type": "array"
          },
          "name": {
            "example": "core/heading",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CategoryContent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseContentItem"
          },
          {
            "properties": {
              "color": {
                "nullable": true,
                "type": "string"
              },
              "description": {
                "nullable": true,
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          }
        ],
        "description": "Content model for カテゴリ",
        "type": "object"
      },
      "ContentStatus": {
        "enum": [
          "draft",
          "scheduled",
          "published",
          "archived"
        ],
        "type": "string"
      },
      "ContentSummary": {
        "description": "A content record in a list with `view=summary`: no blocks and no rendered HTML",
        "properties": {
          "author_id": {
            "nullable": true,
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "excerpt": {
            "description": "The `excerpt` field, or the start of the first paragraph",
            "type": "string"
          },
          "fields": {
            "additionalProperties": true,
            "description": "The schema's custom fields",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "published_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "relations": {
            "additionalProperties": true,
            "description": "Resolved relations by field name",
            "type": "object"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ContentStatus"
          },
          "title": {
            "type": "string"
          },
          "unpublish_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "content_type",
          "title",
          "slug",
          "status",
          "excerpt",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "CreateContentPayload": {
        "properties": {
          "author_id": {
            "nullable": true,
            "type": "string"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/BlockNode"
            },
            "type": "array"
          },
          "publish": {
            "default": false,
            "description": "Update the public snapshot to the saved working version",
            "type": "boolean"
          },
          "published_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ContentStatus"
          },
          "title": {
            "type": "string"
          },
          "unpublish_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "title",
          "slug"
        ],
        "type": "object"
      },
      "FieldDefinition": {
        "properties": {
          "index": {
            "type": "boolean"
          },
          "indexed_paths": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "max_length": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "nullable": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "enum": [
              "string",
              "text",
              "integer",
              "boolean",
              "timestamp",
              "relation",
              "jsonb"
            ],
            "type": "string"
          },
          "unique": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "type": "object"
      },
      "PageContent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseContentItem"
          },
          {
            "properties": {
              "custom_meta": {
                "additionalProperties": true,
                "type": "object"
              },
              "layout": {
                "nullable": true,
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          }
        ],
        "description": "Content model for 固定ページ",
        "type": "object"
      },
      "ProductContent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseContentItem"
          },
          {
            "properties": {
              "buy_url": {
                "nullable": true,
                "type": "string"
              },
              "category_id": {
                "description": "Foreign key relation to category.id",
                "nullable": true,
                "type": "string"
              },
              "compare_at_price": {
                "nullable": true,
                "type": "integer"
              },
              "excerpt": {
                "maxLength": 500,
                "nullable": true,
                "type": "string"
              },
              "image_url": {
                "nullable": true,
                "type": "string"
              },
              "price": {
                "type": "integer"
              },
              "sku": {
                "nullable": true,
                "type": "string"
              },
              "stock": {
                "nullable": true,
                "type": "integer"
              }
            },
            "required": [
              "price"
            ],
            "type": "object"
          }
        ],
        "description": "Content model for 商品",
        "type": "object"
      },
      "SchemaDefinition": {
        "properties": {
          "content_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldDefinition"
            },
            "type": "array"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "content_type",
          "label",
          "fields"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Zero-Trust Extensible Content Management System REST API specification.",
    "title": "AegisCMS REST API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/contents/{content_type}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "content_type",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size (at most 500)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ContentStatus"
            }
          },
          {
            "description": "Search words: a case-insensitive (ASCII) partial match on the title and the slug, and on the `excerpt` field when the schema has one. Only the first 100 characters are used",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "description": "A category id, or `none` for uncategorized. Only for schemas with a `category_id` field (400 otherwise)",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`summary` returns ContentSummary items (no blocks and no rendered HTML, with an `excerpt`), which is cheaper to list. `full` (the default) returns the whole record",
            "in": "query",
            "name": "view",
            "required": false,
            "schema": {
              "default": "full",
              "enum": [
                "full",
                "summary"
              ],
              "type": "string"
            }
          },
          {
            "description": "Keyset pagination cursor: created_at timestamp of the last record from the previous page. Must be used with cursor_id",
            "in": "query",
            "name": "cursor_created_at",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Keyset pagination cursor: id of the last record from the previous page. Must be used with cursor_created_at",
            "in": "query",
            "name": "cursor_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "contents": {
                      "items": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/BaseContentItem"
                          },
                          {
                            "$ref": "#/components/schemas/ContentSummary"
                          }
                        ]
                      },
                      "type": "array"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "next_cursor_created_at": {
                      "nullable": true,
                      "type": "string"
                    },
                    "next_cursor_id": {
                      "nullable": true,
                      "type": "string"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "total": {
                      "description": "The number of records matching the filters",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "contents",
                    "total",
                    "limit",
                    "offset"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "One page of content records (newest first) and the number of matching records"
          }
        },
        "summary": "List contents by content type",
        "tags": [
          "Contents"
        ]
      },
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "content_type",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContentPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseContentItem"
                }
              }
            },
            "description": "Content successfully created"
          },
          "400": {
            "description": "Invalid payload, validation failed or an on-before-save plugin hook failed"
          },
          "404": {
            "description": "Schema content_type not registered"
          },
          "422": {
            "description": "Rejected by an on-before-save plugin hook, or a JSON body that does not match the request type"
          }
        },
        "summary": "Create new content",
        "tags": [
          "Contents"
        ]
      }
    },
    "/api/v1/contents/{content_type}/{slug}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "content_type",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseContentItem"
                }
              }
            },
            "description": "Content record details"
          },
          "404": {
            "description": "Content not found"
          }
        },
        "summary": "Get content by slug",
        "tags": [
          "Contents"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Check if AegisCMS core service is running. `system` and `version` are only returned to an `admin` session.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "example": "ok",
                      "type": "string"
                    },
                    "system": {
                      "example": "AegisCMS",
                      "type": "string"
                    },
                    "timestamp": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "version": {
                      "example": "0.1.0",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "timestamp"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Service is healthy"
          }
        },
        "summary": "Health check",
        "tags": [
          "System"
        ]
      }
    },
    "/api/v1/schemas": {
      "get": {
        "description": "Retrieve list of all active declarative schemas loaded by AegisCMS.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SchemaDefinition"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of schemas"
          }
        },
        "summary": "List all content schemas",
        "tags": [
          "Schemas"
        ]
      }
    },
    "/api/v1/schemas/{content_type}": {
      "get": {
        "parameters": [
          {
            "description": "Content type identifier (e.g. article)",
            "in": "path",
            "name": "content_type",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaDefinition"
                }
              }
            },
            "description": "Schema definition details"
          },
          "404": {
            "description": "Schema not found"
          }
        },
        "summary": "Get schema definition",
        "tags": [
          "Schemas"
        ]
      }
    }
  }
}