{
  "name": "aegis-plugin-react-island-template",
  "version": "0.1.0",
  "entrypoint": "plugin.wasm",
  "display_name": "React Island Block Template",
  "description": "Template for an interactive custom block mounted as a React island via /plugins/<name>/assets/island.js.",
  "author": {
    "name": "AegisCMS Contributors",
    "url": "https://github.com/takumi-mr/AegisCMS"
  },
  "license": "Apache-2.0",
  "tags": [
    "template",
    "react",
    "island",
    "blocks"
  ],
  "min_aegis_version": "0.11.0",
  "abi_version": 2,
  "capabilities": {
    "hooks": [
      "render-blocks",
      "on-render-page"
    ],
    "render_page": {
      "input": [
        "content_html"
      ]
    },
    "csp": {
      "connect_domains": []
    },
    "local_scripts": true
  },
  "resource_limits": {
    "max_memory_mb": 16,
    "max_fuel_units": 20000000,
    "execution_timeout_ms": 250
  },
  "blocks": [
    {
      "name": "counter",
      "label": {
        "en": "React Counter",
        "ja": "React カウンター"
      },
      "description": {
        "en": "An interactive counter card rendered with React",
        "ja": "React で描画するインタラクティブなカウンターカード"
      },
      "fields": [
        {
          "name": "title",
          "type": "text",
          "label": {
            "en": "Title",
            "ja": "見出し"
          },
          "default": "Interactive Counter",
          "required": true
        },
        {
          "name": "initial",
          "type": "number",
          "label": {
            "en": "Initial count",
            "ja": "初期値"
          },
          "default": 0
        },
        {
          "name": "step",
          "type": "number",
          "label": {
            "en": "Step",
            "ja": "増減ステップ"
          },
          "default": 1
        }
      ]
    }
  ]
}
