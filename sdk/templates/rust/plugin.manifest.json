{
  "name": "aegis-plugin-template",
  "version": "0.1.0",
  "entrypoint": "plugin.wasm",
  "display_name": "Rust Plugin Template",
  "description": "Official Rust plugin template built on aegis-plugin-sdk: trims titles on save and appends a footer block.",
  "author": {
    "name": "AegisCMS Contributors",
    "url": "https://github.com/takumi-mr/AegisCMS"
  },
  "license": "Apache-2.0",
  "tags": [
    "template",
    "rust"
  ],
  "min_aegis_version": "0.1.0",
  "capabilities": {
    "network": {
      "allowed_domains": [
        "api.example.com",
        "hooks.slack.com"
      ]
    },
    "storage": {
      "kv_namespace": "template_plugin_state"
    },
    "hooks": [
      "on-before-save",
      "transform-content-ast"
    ]
  },
  "resource_limits": {
    "max_memory_mb": 16,
    "max_fuel_units": 100000000,
    "execution_timeout_ms": 250
  }
}
