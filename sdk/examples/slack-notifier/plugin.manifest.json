{
  "name": "aegis-plugin-slack-notifier",
  "version": "1.0.0",
  "entrypoint": "plugin.wasm",
  "display_name": "Slack Notifier (sample)",
  "description": "Minimal hand-written sample plugin that logs from the on-before-save hook.",
  "author": {
    "name": "AegisCMS Contributors",
    "url": "https://github.com/takumi-mr/AegisCMS"
  },
  "license": "Apache-2.0",
  "tags": [
    "sample"
  ],
  "min_aegis_version": "0.1.0",
  "capabilities": {
    "network": {
      "allowed_domains": [
        "hooks.slack.com"
      ]
    },
    "storage": {
      "kv_namespace": "slack_notifier_state"
    },
    "hooks": [
      "on-before-save",
      "transform-content-ast"
    ]
  },
  "resource_limits": {
    "max_memory_mb": 16,
    "max_fuel_units": 100000000,
    "execution_timeout_ms": 250
  }
}
